# Public dedicated-server image (ghcr.io/zaneris/digblock-server), built
# by .github/workflows/release-server.yml. Unlike docker/Dockerfile (the
# local test rig) this ships only the server binary — no bot, no tc/netem
# tooling. Configuration is env-driven; see deploy/compose.yml for the
# shareable quickstart (config lives inline there; the one .env variable
# is the port, for a second server on the same machine).
#
# Multi-arch: linux/amd64 + linux/arm64 (Raspberry Pi 4/5 on a 64-bit
# OS). Build stages are pinned to $BUILDPLATFORM and cross-compile for
# $TARGETARCH, so rustc never runs under QEMU emulation — only the final
# runtime stage's apt-get does (seconds, not hours).
# Suite-pinned: the bare `1-slim` tag rides Debian's current stable, and
# the bookworm→trixie migration silently changed the cross-toolchain
# packaging (see the libc6-dev-arm64-cross note below). Bump the suite
# here deliberately, with a test release, not via upstream drift.
FROM --platform=$BUILDPLATFORM rust:1-slim-trixie AS chef
RUN cargo install cargo-chef
WORKDIR /app

FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
ARG TARGETARCH
# The cross gcc is only installed when actually cross-compiling — Debian
# ships gcc-aarch64-linux-gnu solely for foreign arches, so a native
# arm64 build (local testing on an ARM Mac / a Pi) must skip it.
# libc6-dev-arm64-cross must be named explicitly: on trixie it is only a
# Recommends of the cross gcc, and --no-install-recommends drops it,
# leaving the compiler without arm64 libc headers (ring's C build dies
# on bits/libc-header-start.h). The
# reverse direction (linux/amd64 from an arm64 host) isn't wired up; CI
# builds on amd64. The linker/CC env is safe either way: Debian's native
# gcc also provides the triplet-prefixed name.
RUN case "$TARGETARCH" in \
		amd64) echo x86_64-unknown-linux-gnu ;; \
		arm64) echo aarch64-unknown-linux-gnu ;; \
		*) echo "unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
	esac > /triple \
	&& rustup target add "$(cat /triple)" \
	&& if [ "$TARGETARCH" = arm64 ] && [ "$(uname -m)" = x86_64 ]; then \
		apt-get update \
		&& apt-get install -y --no-install-recommends gcc-aarch64-linux-gnu libc6-dev-arm64-cross \
		&& rm -rf /var/lib/apt/lists/*; \
	fi
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc \
	CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc
COPY --from=planner /app/recipe.json .
RUN cargo chef cook --release --target "$(cat /triple)" --recipe-path recipe.json -p digblock-server
COPY . .
RUN cargo build --release -p digblock-server --bin digblock-server --target "$(cat /triple)" \
	&& cp "target/$(cat /triple)/release/digblock-server" /digblock-server

# Same suite as the build stage: a binary linked against a newer glibc
# can demand symbol versions an older runtime image lacks, failing only
# at container start. Bump this together with the chef pin above.
FROM debian:trixie-slim
# ca-certificates: the server speaks HTTPS to the master (register,
# heartbeats, token verify).
RUN apt-get update \
	&& apt-get install -y --no-install-recommends ca-certificates \
	&& rm -rf /var/lib/apt/lists/*
COPY --from=builder /digblock-server /usr/local/bin/digblock-server
VOLUME /data
EXPOSE 4433/udp
ENTRYPOINT ["digblock-server"]
CMD ["--port", "4433", "--data-dir", "/data"]
