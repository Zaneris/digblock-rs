# Shown in the public server list.
SERVER_NAME=My DigBlock World

# The address players connect to: this machine's public DNS name or IP.
# UDP 4433 must be reachable from the internet.
ADVERTISE_HOST=play.example.com

# Optional world seed (any number). Changing it later starts a fresh
# world; the old world's journal stays in ./data and comes back if you
# switch the seed back.
#SEED=42

# Optional: pin a specific server release instead of latest.
#VERSION=0.1.0
