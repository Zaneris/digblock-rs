# Cloudflare Pages header overrides (read from the deploy root).
#
# Why this file exists: Pages' defaults hand `.js` a 4-hour browser cache
# (`max-age=14400`) but leave `.wasm` at `max-age=0, must-revalidate`. The
# glue JS and the wasm are ONE artifact — wasm-bindgen mangles import names
# with a per-build hash — so any skew between them is fatal:
#
#   LinkError: Import #17 "./digblock_web_bg.js" "__wbg_done_<hash>":
#   function import requires a callable
#
# That is exactly what a deploy produced: fresh wasm paired with up-to-4h-old
# glue out of the browser's HTTP cache, for anyone who had loaded the site in
# the preceding window. `no-cache` still stores the files, it just forces a
# conditional request (cheap 304s), so the pair can never straddle a release.
/pkg/*
  Cache-Control: no-cache
