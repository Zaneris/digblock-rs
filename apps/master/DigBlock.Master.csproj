<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>DigBlock.Master</RootNamespace>
    <AssemblyName>DigBlock.Master</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- CC0 music tracks served at /music/* (see music/SOURCES.md);
         copied beside the binary so native runs and the container
         resolve the same relative directory. -->
    <Content Include="music/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The master was BCL-only until accounts arrived. These are the whole
       dependency surface, and all of them are first-party:

       - EntityFrameworkCore.Sqlite — accounts are the master's first
         durable state. SQLite is the "for now" store; the point of going
         through EF is that swapping to Postgres is a provider line plus a
         regenerated migration set, so nothing above Data/ may assume SQLite.
       - EntityFrameworkCore.Design — dev-time only (PrivateAssets), for
         `dotnet ef migrations`. It is deliberately NOT shipped.
       - Authentication.Google / .Facebook / .MicrosoftAccount — the OAuth
         handshake with the providers, one package each. Hand-rolling the
         code exchange was considered and declined: state, PKCE and nonce
         handling are exactly the parts worth not reimplementing. That a
         provider costs one package and one options block is the whole
         reason the flow was built around handlers. See AUTH-DESIGN.md.

       Rate limiting needs no package — AddRateLimiter ships in the ASP.NET
       Core shared framework. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Facebook" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
  </ItemGroup>

</Project>
