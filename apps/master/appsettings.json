{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Master": {
    "Probe": {
      "IntervalSeconds": 30,
      "TimeoutSeconds": 5,
      "MaxStrikes": 3,
      "AllowPrivateTargets": false
    },
    "Registry": {
      "IdleTimeoutSeconds": 120
    },
    "Token": {
      "TtlSeconds": 45
    },
    "Db": {
      "Path": "master.db",
      "BusyTimeoutSeconds": 30
    },
    "Account": {
      "SessionDays": 90,
      "NameChangeCooldownDays": 30,
      "NameQuarantineDays": 30
    },
    "Auth": {
      "WebRedirectUris": []
    }
  }
}
